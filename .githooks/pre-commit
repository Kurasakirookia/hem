#!/bin/sh
# Fast gates only. Anything slow belongs in `pnpm verify`, not here, because a
# slow hook gets bypassed with --no-verify and then protects nothing.
#
# Escape hatch for drafts: git commit --no-verify
set -e

echo "pre-commit: checking tokens and lint"
node scripts/check-tokens.mjs
pnpm -s -C frontend lint

# Reminders, not gates. Visual checks stay manual on purpose, because
# accepting a new baseline is a human decision.
if git diff --cached --name-only | grep -qE 'frontend/src/(components|pages|design-system)/'; then
  echo ""
  echo "  UI changed. Next:"
  echo "    pnpm e2e           see whether anything moved"
  echo "    pnpm e2e:update    only if the change was intended, then commit the PNG"
fi

echo ""
echo "  Before pushing: pnpm verify"
